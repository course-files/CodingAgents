# Copy this file to .env (in the same folder) and fill in your own values.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
#
# .env is listed in .gitignore, so Git will never commit it.
# NEVER put a real key in this .env.example file: it IS committed.

# Which model provider to use: gemini (free tier), anthropic (paid), or
# keyword (offline rule-based stand-in, no key needed).
LLM_PROVIDER=gemini

# Google Gemini (free tier, age 18+). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic Claude (paid, billed in the Claude Console, separate from Claude Pro).
# Create a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
